# syntax=docker/dockerfile:1

# ============================================================
# Stage 1 — deps: install node_modules in isolation (cached
# separately from source changes, so editing app code doesn't
# force a full npm install on every rebuild)
# ============================================================
FROM node:20-alpine AS deps

WORKDIR /app

COPY package.json package-lock.json* ./
RUN npm ci

# ============================================================
# Stage 2 — builder: produce the Next.js production build
# ============================================================
FROM node:20-alpine AS builder

WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY . .

ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# ============================================================
# Stage 3 — runtime: Next.js standalone output only — no
# node_modules, no source, no build cache in the final image
# ============================================================
FROM node:20-alpine AS runtime

RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs

WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000

# Next.js's standalone output (next.config.js sets `output: "standalone"`
# — see below) traces only the files actually needed at runtime, which
# is what makes a node_modules-free final image possible at all.
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=builder --chown=nextjs:nodejs /app/public ./public

USER nextjs

EXPOSE 3000

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000/ || exit 1

CMD ["node", "server.js"]
