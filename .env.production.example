# ============================================================
# Trust-Aware Multi-Agent RAG — Production Environment Template
# Fill with production values and provide via cloud secrets manager.
# Never commit real secrets to GitHub.
# ============================================================

# ---------- App Configuration ----------
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=change-me-to-a-strong-random-64-character-secret

# ---------- LLM Providers (Groq Cloud) ----------
GROQ_API_KEY=gsk_your_production_groq_key
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------- Embeddings (HuggingFace) ----------
HUGGINGFACE_API_TOKEN=hf_your_production_hf_token
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---------- Vector Store (FAISS) ----------
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./models/embeddings_cache/faiss_index

# ---------- Supabase PostgreSQL ----------
DATABASE_URL=postgresql+asyncpg://postgres:your_prod_supabase_password@db.your_prod_project_ref.supabase.co:5432/postgres

# ---------- Upstash Redis ----------
REDIS_URL=rediss://default:your_prod_upstash_token@your_prod_upstash_endpoint.upstash.io:6379
REDIS_CACHE_TTL_SECONDS=600

# ---------- Trust Scoring & Decision Thresholds ----------
TRUST_THRESHOLD_HIGH=0.75
TRUST_THRESHOLD_LOW=0.50
TRUST_MODEL_PATH=./models/trust_classifier/trust_xgb.json

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_JSON=true
