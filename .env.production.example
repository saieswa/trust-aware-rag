# ============================================================
# Production Environment Template
# Copy to .env on the production host and fill in real secrets.
# NEVER commit the filled-in file.
# ============================================================

APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=REPLACE_WITH_A_LONG_RANDOM_VALUE   # e.g. `openssl rand -hex 32`

# ---------- LLM Providers ----------
GROQ_API_KEY=REPLACE_WITH_REAL_KEY
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1
HUGGINGFACE_API_TOKEN=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---------- Vector Store ----------
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./models/embeddings_cache/faiss_index

# ---------- PostgreSQL ----------
# Use a strong, unique password in production -- this is not a placeholder
# to leave as-is. Consider a managed database (RDS/Cloud SQL) instead of
# the bundled container for real production traffic.
POSTGRES_USER=trag_user
POSTGRES_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
POSTGRES_DB=trust_aware_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trag_user:REPLACE_WITH_A_STRONG_PASSWORD@postgres:5432/trust_aware_rag

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Trust Model ----------
TRUST_THRESHOLD_HIGH=0.75
TRUST_THRESHOLD_LOW=0.5
TRUST_MODEL_PATH=./models/trust_classifier/trust_xgb.json

# ---------- Frontend ----------
# Set to the real public URL of the backend (behind nginx/your load
# balancer), not localhost, once deployed.
NEXT_PUBLIC_API_URL=https://api.your-domain.example

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_JSON=true
