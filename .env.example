# ============================================================
# Trust-Aware Multi-Agent RAG — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# ---------- App Configuration ----------
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production-random-32-chars

# ---------- LLM Providers (Groq Cloud) ----------
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1

# ---------- Embeddings (HuggingFace) ----------
HUGGINGFACE_API_TOKEN=hf_your_token_here
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---------- Vector Store (FAISS) ----------
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./models/embeddings_cache/faiss_index

# ---------- Supabase PostgreSQL ----------
# Format: postgresql+asyncpg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=postgresql+asyncpg://postgres:your_supabase_password@db.your_project_ref.supabase.co:5432/postgres

# ---------- Upstash Redis ----------
# Format: rediss://default:[YOUR-TOKEN]@[YOUR-ENDPOINT].upstash.io:6379
REDIS_URL=rediss://default:your_upstash_token@your_upstash_endpoint.upstash.io:6379
REDIS_CACHE_TTL_SECONDS=300

# ---------- Trust Scoring & Decision Thresholds ----------
TRUST_THRESHOLD_HIGH=0.75
TRUST_THRESHOLD_LOW=0.50
TRUST_MODEL_PATH=./models/trust_classifier/trust_xgb.json

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Logging ----------
LOG_LEVEL=INFO
LOG_JSON=false
