# ============================================================
# Trust-Aware Multi-Agent RAG — Environment Variables
# Copy this file to .env and fill in real values.
# Never commit the actual .env file.
# ============================================================

# ---------- App ----------
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production

# ---------- LLM Providers ----------
GROQ_API_KEY=gsk-your-groq-key-here
GROQ_MODEL=llama3-8b-8192
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Optional: local/HuggingFace model fallback
HUGGINGFACE_API_TOKEN=hf-your-token-here
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ---------- Vector Store ----------
VECTOR_STORE_PROVIDER=faiss
FAISS_INDEX_PATH=./models/embeddings_cache/faiss_index
# If switching to Milvus later:
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# ---------- PostgreSQL ----------
POSTGRES_USER=trag_user
POSTGRES_PASSWORD=trag_password
POSTGRES_DB=trust_aware_rag
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://trag_user:trag_password@postgres:5432/trust_aware_rag

# ---------- Redis ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Trust Model ----------
TRUST_THRESHOLD_HIGH=0.75
TRUST_THRESHOLD_LOW=0.5
TRUST_MODEL_PATH=./models/trust_classifier/trust_xgb.json

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------- Logging / Monitoring ----------
LOG_LEVEL=INFO
